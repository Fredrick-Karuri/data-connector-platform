# ─────────────────────────────────────────────
#  Data Connector Platform — Environment Variables
#  Copy to .env and fill in values before running
# ─────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Application Database (must match docker-compose app_postgres service)
DATABASE_URL=postgres://dcp_user:dcp_pass@app_postgres:5432/dcp_db

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File Storage
STORAGE_ROOT=/storage

# Mock Source Credentials (used by seed scripts and connector tests)
MOCK_POSTGRES_DSN=postgresql://mock_user:mock_pass@mock_postgres:5432/mock_postgres_db
MOCK_MYSQL_DSN=mysql+connector://mock_user:mock_pass@mock_mysql:3306/mock_mysql_db
MOCK_MONGO_URI=mongodb://mock_user:mock_pass@mock_mongo:27017/mock_mongo_db
MOCK_CLICKHOUSE_HOST=mock_clickhouse
MOCK_CLICKHOUSE_USER=mock_user
MOCK_CLICKHOUSE_PASSWORD=mock_pass
MOCK_CLICKHOUSE_DB=mock_clickhouse_db
